# Gradle / Kotlin
.gradle/
build/
out/
!gradle/wrapper/gradle-wrapper.jar
*.class

# IntelliJ IDEA / Eclipse / VSCode
.idea/
*.iml
*.ipr
*.iws
.vscode/
.classpath
.project
.settings/

# CData JDBC Driver（ライセンス・JARファイル・OAuth トークン）
lib/*.jar
lib/*.lic
lib/*.txt
lib/help/

# 開発時にデバッグ用にコピーした proto ディレクトリ
.proto/

# 設定ストア（SQLite）
# JDBC 接続文字列＝認証情報を含むため、絶対にコミットしないこと。
config/config.db
config/config.db-wal
config/config.db-shm
config/*.db
config/*.db-wal
config/*.db-shm

# 参考資料（社外開示NG含む）。プロジェクトルート直下のみ。
# `.claude/skills/.../reference/` 等の他階層の reference は含めない
/reference/

# 環境変数
.env
.env.local

# Agent の機密ファイル（バイナリ自体も大きいので除外）
agent/agent.json
agent/*.pem
agent/bin/
!agent/*.example

# フェーズ2-A: 複数テーブル用 Agent 設定（example のみコミット可）
agent/tables/*/agent.json
!agent/tables/*/agent.json.example

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Runtime state (active-adapters.json 等)
run/

# Buf 生成物（buildディレクトリ内に出るが念のため）
gen/
.partnership/協業相談資料.pdf
.partnership/協業相談資料.pptx

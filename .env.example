# Salesforce 認証情報（実体の .env は .gitignore 済み）
# このファイルから .env にコピーして、各値を埋めてください
#
# 取得方法:
#   - SF_USER          : Salesforce ログインメールアドレス
#   - SF_PASSWORD      : ログインパスワード
#   - SF_SECURITY_TOKEN: Salesforce → 個人設定 → ID → セキュリティトークンのリセット で取得
#                        （初回はメールで届く）

SF_USER=your_user@example.com
SF_PASSWORD=your_password
SF_SECURITY_TOKEN=your_security_token

# Salesforce が Sandbox の場合は以下を true に
# SF_USE_SANDBOX=true

# ログレベル
LOG_LEVEL=INFO

# ===== kintone Agent 連携用 =====
# kintone でコネクター登録時に発行された JWT トークン（1度しか表示されない）
# 取得方法: kintone システム管理 → 外部システムコネクターの管理 → コネクター追加 → 公開鍵登録 → トークン発行
KINTONE_AGENT_TOKEN=eyJhbGci...（kintone で発行された JWT を貼り付け）

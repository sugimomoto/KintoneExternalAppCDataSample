{
  "_comment": "Account テーブル用 Agent 設定。実体 (agent.json) は .gitignore 済み。",
  "_comment_token": "kintone Account コネクターから発行された JWT トークン",
  "token": "REPLACE_WITH_TOKEN_FOR_ACCOUNT_CONNECTOR",

  "_comment_addr": "Account 用 Adapter の待ち受けアドレス。MultiAdapterRunner が割り当てたポートを指定",
  "adapter_addr": "host.docker.internal:18001",

  "adapter_plaintext": true,

  "_comment_key": "全 Agent で共有する秘密鍵（鍵ペアはテーブル間で同一でよい。Connector ごとに異なるのは token のみ）",
  "private_key_path": "/opt/agent/private-key.pem"
}

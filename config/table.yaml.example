# 接続対象テーブルとカラムマッピング
# `adapter init-table` で対話的に自動生成可能。
# 例: Salesforce の Account オブジェクトの主要カラムをマッピング。

name: Account

primary-key:
  kintone-field-id: id
  jdbc-column: Id

columns:
  - kintone-field-id: name
    jdbc-column: Name
    type: TEXT

  - kintone-field-id: revenue
    jdbc-column: AnnualRevenue
    type: NUMBER

  - kintone-field-id: industry
    jdbc-column: Industry
    type: SELECTION
    options:
      - Agriculture
      - Banking
      - Construction
      - Consulting
      - Manufacturing
      - Retail
      - Technology

  - kintone-field-id: created_at
    jdbc-column: CreatedDate
    type: DATETIME

  - kintone-field-id: phone
    jdbc-column: Phone
    type: TEXT

  - kintone-field-id: website
    jdbc-column: Website
    type: TEXT

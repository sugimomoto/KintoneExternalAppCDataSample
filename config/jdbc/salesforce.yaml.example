# 共通 JDBC 設定: Salesforce
# 複数テーブルから `jdbc-ref.yaml` で参照される。
# このファイルは機密情報を含むため、実体はリポジトリにコミットしないこと。
# `salesforce.yaml.example` を `salesforce.yaml` にコピーしてから値を埋める。

driver-class: cdata.jdbc.salesforce.SalesforceDriver
driver-jar: ./lib/cdata.jdbc.salesforce.jar

# 接続文字列。${VAR} 形式で環境変数を埋め込み可能。
# Salesforce の認証パターン例:
#   - Trial/Dev:    User + Password + SecurityToken
#   - OAuth (組織):  OAuthClientId + OAuthClientSecret + RefreshToken
url: "jdbc:salesforce:User=${SF_USER};Password=${SF_PASSWORD};SecurityToken=${SF_SECURITY_TOKEN};InitiateOAuth=GETANDREFRESH;LoginURL=${SF_LOGIN_URL};"

pool:
  maximum-pool-size: 10
  connection-timeout: 30000

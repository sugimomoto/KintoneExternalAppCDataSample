# Google Sheets Orders のサポート機能宣言
# Sheets はテキスト型 PK が多いので record-id-type: TEXT。

select-supported: true
insert-supported: true
update-supported: true
delete-supported: true
count-supported: true

# Sheets は COUNT が比較的軽いので ACTUAL でよい
count-strategy: ACTUAL

search-supported: false
aggregate-supported: false

record-id-type: TEXT

filterable-fields:
  - id
  - customer
  - status

sortable-fields:
  - id
  - ordered_at
